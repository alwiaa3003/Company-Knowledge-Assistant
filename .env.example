# Copy this file to .env and fill in your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Model names (checked 2026-11-23 — they change often, re-check the docs)
GEN_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768

# Paid-tier prices in USD per 1M tokens, used only to ESTIMATE cost per request
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=2.50
PRICE_EMBED_PER_M=0.20
